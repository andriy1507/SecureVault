# ── Build output (Kotlin Toolchain / Amper, Gradle, Kotlin) ──
build/
.kotlin/
.amper/
.gradle/
out/
captures/
*.apk
*.aab
*.ap_
*.dex
.externalNativeBuild/
.cxx/

# ── Local machine config & secrets: never commit ──
local.properties
*.jks
*.keystore
keystore.properties
signing.properties
.env
.env.*
# Recovery-key exports (Save as .txt) if one ever lands in the project folder
vault-recovery-key-*.txt

# ── IDE: IntelliJ / Android Studio (shared project files stay, see .idea/.gitignore) ──
*.iml
*.ipr
*.iws
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/dictionaries/
.idea/assetWizardSettings.xml
.idea/navEditor.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml
.idea/AndroidProjectSystem.xml
.idea/androidTestResultsUserPreferences.xml
.idea/appInsightsSettings.xml
.idea/other.xml
.vscode/
.fleet/

# ── Xcode / iOS ──
**/module.xcodeproj/*
!**/module.xcodeproj/project.pbxproj
!**/module.xcodeproj/xcshareddata/
!**/module.xcodeproj/project.xcworkspace/
**/xcshareddata/WorkspaceSettings.xcsettings
xcuserdata/
*.xcuserstate
DerivedData/
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
Pods/
.swiftpm/

# ── Logs & crash dumps ──
*.log
hs_err_pid*
replay_pid*

# ── OS files ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~

# ── Lint tool cache (ktlint/detekt jars) ──
.lint-cache/

# ── graphify knowledge graph output (rebuildable) ──
graphify-out/
